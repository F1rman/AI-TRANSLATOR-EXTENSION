  },
  "devDependencies": {
    "@types/chrome": "^0.1.24",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.25.11",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
